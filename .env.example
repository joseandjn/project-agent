# --- App ---
ENVIRONMENT=development
ALLOWED_ORIGINS=*

# --- Proveedor de LLM: "ollama" (self-hosted, por defecto), "openai" o "anthropic" ---
LLM_PROVIDER=ollama

# --- Ollama (LLM + embeddings, self-hosted) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Embeddings de buscar_alimentos: "ollama" (por defecto) u "openai" (no necesita Ollama) ---
EMBEDDING_PROVIDER=ollama
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- OpenAI (solo si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Anthropic (solo si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# --- PostgreSQL + pgvector (self-hosted) ---
POSTGRES_DSN=postgresql+asyncpg://vethis:vethis@localhost:5432/vethis

# --- Redis (self-hosted) ---
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800

# --- Autenticacion: JWT propio que el backend de la tienda pide con su API key ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=3600

# --- Memoria de largo plazo (perfil de cliente en Postgres) ---
# MEMORIA_INACTIVIDAD_SEGUNDOS debe ser menor que SESSION_TTL_SECONDS.
# MEMORIA_MODEL vacio => el extractor usa el mismo modelo del chat.
MEMORIA_CONSOLIDAR_CADA_N_TURNOS=5
MEMORIA_INACTIVIDAD_SEGUNDOS=1500
MEMORIA_SWEEP_INTERVALO_SEGUNDOS=60
MEMORIA_MODEL=

# --- Langfuse Cloud (trazas por turno; docs/observabilidad_langfuse.md) ---
# Apagado por defecto. Para prenderlo: LANGFUSE_ENABLED=true + las claves del proyecto.
# Region: EU https://cloud.langfuse.com  |  US https://us.cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0

# --- Evals (opcional): modelo juez para evals/, si se deja vacio usa el mismo que LLM_PROVIDER ---
EVAL_JUDGE_MODEL=

# --- Neo4j (experimento aislado: grafo del catalogo en graph_neo4j/, no lo usa el agente) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vethis1234

# --- Rate limits (docs/rate_limits.md). 0 desactiva una regla ---
RATE_LIMIT_ENABLED=true
RL_CHAT_SESION_POR_MINUTO=10
RL_CHAT_CLIENTE_POR_MINUTO=20
RL_CHAT_TIENDA_POR_MINUTO=300
RL_CHAT_TIENDA_POR_DIA=10000
RL_TOKEN_TIENDA_POR_MINUTO=120
RL_API_KEY_INVALIDA_IP_POR_MINUTO=10
RL_REFRESH_SESION_POR_MINUTO=10
RL_FEEDBACK_SESION_POR_MINUTO=30
RL_MEMORIA_CLIENTE_POR_MINUTO=20

# --- Control de tema (app/guardrails/tema.py) ---
TEMA_GUARD_ENABLED=true
# TEMA_MODEL=                 # vacio = el modelo del chat
# Lineas de ayuda (Peru; verificar vigencia):
# TEMA_AYUDA_SALUD_MENTAL=En Perú puedes llamar gratis a la Línea 113, opción 5 (salud mental del MINSA).
# TEMA_AYUDA_EMERGENCIA=Si alguien está en peligro inmediato, llama al 106 (SAMU) o al 105 (Policía).

# --- Limites por turno del agente y del proveedor (docs/rate_limits.md) ---
AGENTE_MAX_LLAMADAS_MODELO=8
AGENTE_MAX_LLAMADAS_TOOLS=12
AGENTE_MAX_PASOS=150          # >= 15 x AGENTE_MAX_LLAMADAS_MODELO (se valida al arrancar)
AGENTE_TIMEOUT_SEGUNDOS=60
LLM_TIMEOUT_SEGUNDOS=30
LLM_MAX_REINTENTOS=2
# LLM_FALLBACK_MODEL=gpt-4.1-mini            # mismo proveedor, o "anthropic:claude-..." / "ollama:llama3.1:8b"
