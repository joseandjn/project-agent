# --- App ---
ENVIRONMENT=development
ALLOWED_ORIGINS=*

# --- Proveedor de LLM: "ollama" (self-hosted, por defecto), "openai" o "anthropic" ---
LLM_PROVIDER=ollama

# --- Ollama (LLM + embeddings, self-hosted) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI (solo si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Anthropic (solo si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# --- PostgreSQL + pgvector (self-hosted) ---
POSTGRES_DSN=postgresql+asyncpg://vethis:vethis@localhost:5432/vethis

# --- Redis (self-hosted) ---
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800

# --- Autenticacion: JWT propio que el backend de la tienda pide con su API key ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=3600

# --- Memoria de largo plazo (perfil de cliente en Postgres) ---
# MEMORIA_INACTIVIDAD_SEGUNDOS debe ser menor que SESSION_TTL_SECONDS.
# MEMORIA_MODEL vacio => el extractor usa el mismo modelo del chat.
MEMORIA_CONSOLIDAR_CADA_N_TURNOS=5
MEMORIA_INACTIVIDAD_SEGUNDOS=1500
MEMORIA_SWEEP_INTERVALO_SEGUNDOS=60
MEMORIA_MODEL=

# --- Langfuse (self-hosted, observabilidad) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Evals (opcional): modelo juez para evals/, si se deja vacio usa el mismo que LLM_PROVIDER ---
EVAL_JUDGE_MODEL=

# --- Neo4j (experimento aislado: grafo del catalogo en graph_neo4j/, no lo usa el agente) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vethis1234
