# .env del SERVIDOR de la demo (docs/despliegue_azure.md). Copiar como .env en la carpeta
# del proyecto en el servidor y completar. Nunca subir este archivo con valores a git.
# Generar secretos con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Dominio publico (DNS name label de la IP de Azure)
DOMAIN=vethis-demo.eastus2.cloudapp.azure.com

# Contrasenas internas (Postgres y Redis no se exponen a internet)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# App
ENVIRONMENT=demo
ALLOWED_ORIGINS=*

# LLM y embeddings (OpenAI; sin Ollama en el servidor)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Autenticacion (secreto propio de la demo, >= 32 bytes; distinto del local)
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Chat (perfil "chat"): API key de la tienda que usa el chat. Crearla en el servidor con
#   docker compose -f docker-compose.prod.yml exec api python -m scripts.crear_tienda "Tienda Chat"
CHAT_API_KEY=

# Neo4j (perfil "neo4j"): guias nutricionales por tienda. Vacio => guia por defecto.
NEO4J_URI=bolt://neo4j:7687
NEO4J_PASSWORD=

# Langfuse Cloud (opcional): las trazas quedan con environment "demo"
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
